[Unit]
Description=DV Power Monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dvmonitor
WorkingDirectory=/home/dvmonitor/DV_Power_Monitor_Actual
Environment=MPLBACKEND=Agg
ExecStart=/bin/bash /home/dvmonitor/DV_Power_Monitor_Actual/arrancar_pi.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
